<?xml version="1.0"?>
<robot name="escalera">
  <!-- Dimensiones en metros: contrahuella 0.17, huella 0.30, ancho 0.40.
       Escalera de 8 peldaños; X = avance, Y = ancho, Z = altura. -->
  <link name="base">
    <visual>
      <origin xyz="0 0 -0.005"/>
      <geometry><box size="0.001 0.40 0.01"/></geometry>
      <material name="suelo"><color rgba="0.35 0.35 0.35 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005"/>
      <geometry><box size="0.001 0.40 0.01"/></geometry>
    </collision>
  </link>

  <link name="peldaño_1">
    <visual>
      <geometry><box size="0.30 0.40 0.170"/></geometry>
      <material name="material_peldaño"><color rgba="0.65 0.65 0.68 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.30 0.40 0.170"/></geometry>
    </collision>
  </link>
  <joint name="union_peldaño_1" type="fixed">
    <parent link="base"/>
    <child link="peldaño_1"/>
    <origin xyz="0.150 0 0.085" rpy="0 0 0"/>
  </joint>

  <link name="peldaño_2">
